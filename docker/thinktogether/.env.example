# Copy with setup-local.ps1. Never reuse the example security values.
TT_ENABLED=true
TT_ORG_SLUG=default
TT_HTTP_PORT=8096
TT_API_PORT=1349
LEARNHOUSE_DOMAIN=localhost:8096
LEARNHOUSE_INITIAL_ORG_NAME=ThinkTogether
LEARNHOUSE_INITIAL_ORG_SLUG=default
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@school.dev
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
NEXTAUTH_SECRET=
COLLAB_INTERNAL_KEY=
TT_INTERNAL_KEY=
TT_COLLAB_URL=http://collab:4000
POSTGRES_PASSWORD=
LEARNHOUSE_SQL_CONNECTION_STRING=
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/0
LEARNHOUSE_REDIS_URL=redis://redis:6379/0
TT_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
NEXT_PUBLIC_THINKTOGETHER=true
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost:8096
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_HTTPS=false
NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost:8096/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost:8096/
NEXT_PUBLIC_COLLAB_URL=ws://localhost:8096/collab
NEXT_PUBLIC_LEARNHOUSE_OSS=true
NEXTAUTH_URL=http://localhost:8096
HOSTNAME=0.0.0.0
LEARNHOUSE_PORT=9000
LEARNHOUSE_OSS=true
LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_LOGFIRE_ENABLED=False
LEARNHOUSE_DISABLE_EE=1
LEARNHOUSE_CONTENT_DELIVERY_TYPE=filesystem
# Local first boot creates schema. Production uses explicit migrations.
LEARNHOUSE_AUTO_MIGRATE=true
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_GEMINI_API_KEY=
LEARNHOUSE_IS_AI_ENABLED=False
# Select a reviewed, calibrated model version before enabling AI scoring.
TT_REASONING_MODEL=
# AI course authoring model; falls back to TT_REASONING_MODEL when unset.
TT_CONTENT_MODEL=
# Optional course-only provider (leaves grading and voice unchanged).
TT_CONTENT_ENABLED=false
TT_CONTENT_PROVIDER=
TT_CONTENT_API_KEY=
TT_FACILITATOR_MODEL=gemini-3.5-flash
# Optional explicit release prices; unset means cost unknown, never free.
TT_AI_PRICING_JSON=
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TT_POLAR_ENVIRONMENT=sandbox
TT_POLAR_ACCESS_TOKEN=
TT_POLAR_WEBHOOK_SECRET=
TT_POLAR_SUCCESS_URL=http://localhost:8096/thinktogether/billing
TT_SOURCE_URL=/thinktogether-source.tar.gz
# Release gates are evidence acknowledgments, never development shortcuts.
TT_POLAR_PRODUCTION_APPROVED=false
TT_AI_EVALUATION_APPROVED=false
TT_RESTORE_DRILL_PASSED=false
TT_RELEASE_APPROVED=false
