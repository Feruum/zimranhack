# Reuse the pinned upstream Python runtime, then replace all API source with
# the reviewed fork. The upstream all-in-one entrypoint is never started.
FROM ghcr.io/learnhouse/app@sha256:abe78e2331f12351684ee2dbe86d88b61b8e12ea88c421ae7dadd1483a8e4c7f
WORKDIR /app/api
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache
COPY apps/api/requirements-thinktogether.txt /tmp/requirements-thinktogether.txt
RUN uv pip install --python /app/api/.venv/bin/python --no-cache -r /tmp/requirements-thinktogether.txt \
    && apk add --no-cache ffmpeg \
    && addgroup -S -g 1001 thinktogether \
    && adduser -S -D -u 1001 -G thinktogether thinktogether \
    && mkdir -p "$TIKTOKEN_CACHE_DIR" \
    && /app/api/.venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
COPY apps/api /app/api
RUN mkdir -p content logs data && chown -R 1001:1001 content logs data
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TT_ENABLED=true
USER 1001:1001
EXPOSE 9000
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=12 CMD curl -fsS http://127.0.0.1:9000/api/v1/health || exit 1
CMD ["/app/api/.venv/bin/uvicorn", "app:app", "--host", "0.0.0.0", "--port", "9000"]
