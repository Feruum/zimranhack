# Copy to ../../.learnhouse/thinktogether-production.env; use separate staging keys.
# This file is an operator template. Blank required values must be supplied.
TT_ENV_FILE=../../.learnhouse/thinktogether-production.env
TT_IMAGE_PREFIX=ghcr.io/your-organization/thinktogether
TT_RELEASE=REPLACE_WITH_IMMUTABLE_RELEASE_TAG
TT_ENABLED=true
TT_ORG_SLUG=default
LEARNHOUSE_DOMAIN=learn.example.com
NEXTAUTH_URL=https://learn.example.com
NEXT_PUBLIC_THINKTOGETHER=true
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=learn.example.com
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=learn.example.com
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_HTTPS=true
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://learn.example.com/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://learn.example.com/
NEXT_PUBLIC_COLLAB_URL=wss://learn.example.com/collab
NEXT_PUBLIC_LEARNHOUSE_OSS=true
LEARNHOUSE_OSS=true
LEARNHOUSE_DISABLE_EE=1
LEARNHOUSE_DEVELOPMENT_MODE=False
LEARNHOUSE_ENV=production
NEXT_PUBLIC_LEARNHOUSE_ENV=production
LEARNHOUSE_SSL=True
LEARNHOUSE_LOGFIRE_ENABLED=False
LEARNHOUSE_AUTO_MIGRATE=false
LEARNHOUSE_PORT=9000
LEARNHOUSE_AUTH_JWT_SECRET_KEY=
NEXTAUTH_SECRET=
COLLAB_INTERNAL_KEY=
TT_INTERNAL_KEY=
TT_COLLAB_URL=http://collab:4000
TT_AI_PRICING_JSON=
# Neon: separate project/branch for staging and production. Require TLS.
# Use the direct endpoint for explicit migrations; app endpoint may be pooled.
LEARNHOUSE_SQL_CONNECTION_STRING=
TT_MIGRATION_DATABASE_URL=
# Optional worker DSN; omit to use LEARNHOUSE_SQL_CONNECTION_STRING.
TT_DATABASE_URL=
LEARNHOUSE_INITIAL_ORG_NAME=ThinkTogether
LEARNHOUSE_INITIAL_ORG_SLUG=default
LEARNHOUSE_INITIAL_ADMIN_EMAIL=
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=
# Private Redis is included in production.compose.yml and is never host-published.
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/0
LEARNHOUSE_REDIS_URL=redis://redis:6379/0
TT_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
TT_WORKER_CONCURRENCY=2
# Cloudflare R2 S3 API. Disable bucket public access and r2.dev access.
LEARNHOUSE_CONTENT_DELIVERY_TYPE=s3api
LEARNHOUSE_S3_API_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
LEARNHOUSE_S3_API_BUCKET_NAME=thinktogether-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_EC2_METADATA_DISABLED=true
# Google/Gemini via existing Pydantic AI adapter. Pin evaluated model IDs.
LEARNHOUSE_AI_PROVIDER=google
LEARNHOUSE_AI_API_KEY=
LEARNHOUSE_IS_AI_ENABLED=True
TT_REASONING_MODEL=
# AI course authoring model; falls back to TT_REASONING_MODEL when unset.
TT_CONTENT_MODEL=
# Optional course-only provider (leaves grading and voice unchanged).
TT_CONTENT_ENABLED=false
TT_CONTENT_PROVIDER=
TT_CONTENT_API_KEY=
# Official DeepSeek API for the separate document course pipeline (API + worker).
DEEPSEEK_API_KEY=
TT_FACILITATOR_MODEL=
# Set these after choosing and checking the provider's available models.
LEARNHOUSE_AI_MODEL_FAST=
LEARNHOUSE_AI_MODEL_STANDARD=
LEARNHOUSE_AI_MODEL_PRO=
LEARNHOUSE_EMAIL_PROVIDER=resend
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=learning@example.com
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=ThinkTogether
# Same LiveKit Cloud project on API and voice worker. No recording configured.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TT_API_URL=http://api:9000/api/v1/tt
TT_TTS_VOICE=f31cc6a7-c1e8-4764-980c-60a361443dd1
# Dashboard webhook API version 2026-10; URL /api/v1/tt/billing/webhooks/polar.
TT_POLAR_ENVIRONMENT=production
TT_POLAR_ACCESS_TOKEN=
TT_POLAR_WEBHOOK_SECRET=
TT_POLAR_SUCCESS_URL=https://learn.example.com/thinktogether/billing
TT_SOURCE_URL=/thinktogether-source.tar.gz
# Connect only after validating private-field scrubbing; no credentials in DSNs.
LEARNHOUSE_SENTRY_DSN=
NEXT_PUBLIC_LEARNHOUSE_SENTRY_DSN=
# Evidence acknowledgments; copying this template must not open sales.
TT_POLAR_PRODUCTION_APPROVED=false
TT_AI_EVALUATION_APPROVED=false
TT_RESTORE_DRILL_PASSED=false
TT_RELEASE_APPROVED=false
